# Copy to .env and fill in. Secrets live here only — never in config.yaml.
# .env is gitignored; .env.example never contains a real key.

# --- provider (groq | openai | anthropic | gemini | mistral) ---------------
LLM_PROVIDER=groq

# --- Groq (default) ---------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# Pin the exact model id from https://console.groq.com/docs/models
# (ids change as Groq rotates its catalog; openai/gpt-oss-120b verified
# 2026-11-11. The app stops with the valid-id list if the id is wrong.)
GROQ_MODEL=openai/gpt-oss-120b

# --- other providers (uncomment + set LLM_PROVIDER to switch) ---------------
# Model ids for these come from config/config.yaml llm.model.
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GEMINI_API_KEY=your-gemini-api-key
# MISTRAL_API_KEY=your-mistral-api-key
