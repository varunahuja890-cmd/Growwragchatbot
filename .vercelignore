# Never upload local or generated state to Vercel.
/artifacts/
/.vercel/
/.venv/
/venv/
__pycache__/
*.py[cod]
/.pytest_cache/
/.cache/
/.env
/.env.*

# The root requirements.txt is the LOCAL Streamlit stack (torch,
# sentence-transformers, chromadb, streamlit). Uploading it makes Vercel's
# framework detector pick the generic "python" preset — a single serverless
# app that demands one entrypoint — instead of building api/*.py as
# file-based functions. api/requirements.txt is the function's manifest and
# is uploaded normally. See Docs/architecture.md §8.1.
/requirements.txt
